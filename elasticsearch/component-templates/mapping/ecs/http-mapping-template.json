{
    "template": {
        "mappings": {
            "properties" : {
                "http": {
                    "properties":{
                        "request": {
                            "properties":{
                                "method":{"type":"keyword"}
                            }
                        },
                        "response": {
                            "properties":{
                                "status_code":{"type":"long"}
                            }
                        },
                        "version":{"type":"keyword"}
                    }
                },
                "url": {
                    "properties": {
                        "full": {"type":"wildcard"},
                        "domain": {"type":"keyword"},
                        "path": {"type":"wildcard"},
                        "query": {"type":"wildcard"},
                        "original": {"type":"wildcard"},
                        "scheme": {"type":"keyword"},
                        "port": {"type":"long"}
                    }
                }
            }
        }
    }
}