{
    "template": {
        "mappings": {
            "properties": {
                "container": {
                    "properties": {
                        "id": {"type": "keyword"},
                        "name": {"type": "keyword"},
                        "runtime": {"type": "keyword"},
                        "cpu": {
                            "properties": {
                                "usage": {
                                    "type": "scaled_float",
                                    "scaling_factor": 1000
                                }
                            }
                        },
                        "memory": {
                            "properties": {
                                "usage": {
                                    "type": "scaled_float",
                                    "scaling_factor": 1000
                                }
                            }
                        },
                        "disk": {
                            "properties": {
                                "read": {
                                    "properties": {
                                        "bytes": {"type": "long"}
                                    }
                                },
                                "write": {
                                    "properties": {
                                        "bytes": {"type": "long"}
                                    }
                                }
                            }
                        },
                        "network": {
                            "properties": {
                                "egress": {
                                    "properties": {
                                        "bytes": {"type": "long"}
                                    }
                                },
                                "ingress": {
                                    "properties": {
                                        "bytes": {"type": "long"}
                                    }
                                }
                            }
                        },
                        "image": {
                            "properties": {
                                "name": {"type": "keyword"},
                                "tag": {"type": "keyword"},
                                "hash": {
                                    "properties": {
                                        "all": {"type": "keyword"}
                                    }
                                }
                            }
                        },
                        "labels": {"type": "flattened"},
                        "security_context": {
                            "properties": {
                                "privileged": {"type": "boolean"}
                            }
                        }
                    }
                }
            }
        }
    }
}
